# ---- AI provider (never hard-code a model in code) ----
LLM_PROVIDER=offline          # offline | openai | gemini
LLM_MODEL=                    # e.g. gpt-4o-mini / gemini-1.5-flash
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Razorpay (Test Mode credentials) ----
# https://dashboard.razorpay.com/app/keys  — use Test keys for development/demo
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=          # SERVER ONLY — never expose to the frontend
RAZORPAY_WEBHOOK_SECRET=
# mock = simulate order/payment lifecycle without calling Razorpay (offline dev only).
# For the real demo transaction, set keys above and RAZORPAY_MODE=live.
RAZORPAY_MODE=mock

# ---- Services ----
DATABASE_URL=sqlite:///./data/app.db
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# ---- Dataset generation ----
CATALOG_SEED=42               # deterministic generation — keep stable for before/after demos
